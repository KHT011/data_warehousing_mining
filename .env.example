TMDB_TOKEN=
AIRFLOW_PORT=8080

# Container caps are shared with the Docker Desktop VM and other projects.
# Manual full load: start with 8 GB for Docker Desktop and stop other heavy jobs.
# Airflow full load: start with 12 GB if your computer has enough RAM.
PROJECT_CPUS=2.0
PROJECT_MEMORY_LIMIT=6g
AIRFLOW_CPUS=3.0
AIRFLOW_MEMORY_LIMIT=7g

# Engine budgets are smaller than the container caps to leave overhead room.
SPARK_CORES=2
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DRIVER_MEMORY=3g
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=4GB
